# ==========================================================================
# JC Lavagem a Seco — exemplo de variáveis de ambiente
# Copie para .env e ajuste. NUNCA comite o .env real.
# ==========================================================================

# ---------- BANCO DE DADOS (OBRIGATÓRIO) ----------
# Produção: PostgreSQL (Neon) — usado pela Vercel e pelo build (prisma db push).
# No painel do Neon: Project → Connection String (Pooler), inclua ?sslmode=require.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ---------- SEGURANÇA ----------
# Token de USO ÚNICO para criar o primeiro administrador em /admin/setup.
# Gere algo forte: openssl rand -base64 32
# Após criar o admin, remova ou troque este valor.
ADMIN_SETUP_TOKEN="troque-por-um-token-forte-e-unico"

# ---------- SITE ----------
# URL pública absoluta (usada em canonical, sitemap, robots e JSON-LD).
# Em desenvolvimento pode deixar o localhost. Deve começar com NEXT_PUBLIC_
# para poder ser lida no cliente sem erro.
NEXT_PUBLIC_SITE_URL="https://www.jclavagemaseco.com.br"

# ---------- AMBIENTE ----------
NODE_ENV="development"

# ---------- OPCIONAL: LLM para o chatbot ----------
# O chatbot funciona 100% sem chave (FAQ + palavras-chave + fallback WhatsApp).
# Se quiser respostas em linguagem natural no futuro, integre aqui no SERVIDOR
# apenas (nunca no cliente) — ver docs/INTEGRACOES-PENDENTES.md
# ZAI_API_KEY=""
